.envrc
.agents
openclaw-main/

# Local config (see ansina.example.toml)
ansina.toml

# SQLite database + WAL sidecar files (see src/ansina/storage/)
*.db
*.db-wal
*.db-shm

# Heart bench reports (issue #58 planning): no longer committed — a growing,
# per-fixture-raw-output report corpus belongs in an object store, not git
# history. make heart-bench / make remote-heart still write here for local
# analysis; issue #59 adds the S3-compatible upload (make heart-bench-publish,
# [telemetry.s3]) and migrates the reports already in git history (now
# untracked, kept on disk) into it.
docs/heart/bench/

# Heart soak reports (issue #56, same reasoning as docs/heart/bench/ above —
# issue #59's S3-compatible upload covers this directory too): make
# remote-heart-soak-fetch renders docs/heart/soak/soak-<date>.md here for local
# analysis. The trailing slash matters — docs/heart/soak.md (the committed
# procedure) must stay tracked.
docs/heart/soak/

# Python — none of these have a leading slash, so they already match at any depth,
# tui/'s own .venv/.coverage/caches (issue #31) included. tui/uv.lock is committed
# (matches nothing here) the same way the root uv.lock is.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
