.envrc
.agents
openclaw-main/

# Local config (see ansina.example.toml)
ansina.toml

# SQLite database + WAL sidecar files (see src/ansina/storage/)
*.db
*.db-wal
*.db-shm

# Python — none of these have a leading slash, so they already match at any depth,
# tui/'s own .venv/.coverage/caches (issue #31) included. tui/uv.lock is committed
# (matches nothing here) the same way the root uv.lock is.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/
